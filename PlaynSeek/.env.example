# Archivo de entorno de ejemplo para Play N Seek
# Copia este archivo a .env en el backend y asigna valores reales.

# ==========================================
# Configuración del Backend (Express + Mongo)
# ==========================================
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/playnseek
JWT_SECRET=secreto_para_firma_de_tokens_jwt
JWT_EXPIRES_IN=7d

# Servicio de Correo (Verificación de cuentas)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=no-reply@playnseek.com
SMTP_PASS=password_de_aplicacion_segura
FRONTEND_URL=http://localhost:4200

# ==========================================
# Frontend (Angular 22)
# ==========================================
# La URL de la API se configura en src/environments/environment.ts y environment.development.ts
# Development: http://localhost:3000
# Production: https://api.playnseek.com
